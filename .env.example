APP_NAME="Mesa Digital"
APP_ENV=local
APP_URL=http://localhost:8085
APP_KEY=dGhpcy1pcy1hLXNlY3JldC1rZXktZm9yLWRldmVsb3BtZW50
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es_AR

# Autenticación: 'simulado' para desarrollo local o 'google' para producción / Workspace OAuth
AUTH_DRIVER=simulado
LOGIN_SIMULADO_HABILITADO=true

# Google Workspace OAuth 2.0 (requerido si AUTH_DRIVER=google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_HD=reditinere.com

# Base de Datos MySQL 8.0+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mesa_digital
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Envío de Correos (SMTP / PHPMailer)
MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=mesadigital@reditinere.com
MAIL_FROM_NAME="Mesa Digital — Red Itínere"

# Almacenamiento Local de Documentos
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/documentos
UPLOAD_MAX_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,webp
