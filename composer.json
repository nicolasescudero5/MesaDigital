{
  "name": "red-itinere/mesa-digital",
  "description": "Sistema Mesa Digital para la Suite Red Itínere",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "nikic/fast-route": "^1.3",
    "php-di/php-di": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.0",
    "phpmailer/phpmailer": "^6.9",
    "google/apiclient": "^2.15",
    "intervention/image": "^3.0",
    "robmorgan/phinx": "^0.16"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Support/Helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": false,
    "sort-packages": true,
    "allow-plugins": {}
  },
  "extra": {
    "google/apiclient-services": [
      "Oauth2"
    ]
  },
  "scripts": {
    "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
    "test": "phpunit"
  }
}
